# Production — copy to .env on the server and fill every value.
APP_ENV=production
SECRET_KEY=generate-a-long-random-string
CALENDAR_MODE=google
DATABASE_URL=postgresql+psycopg2://legal:change-me@postgres:5432/legal_scheduler
TIMEZONE=Europe/Skopje
WORKING_DAY_START=09:00
WORKING_DAY_END=17:00
LUNCH_START=12:00
LUNCH_END=13:00
SLOT_INTERVAL_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=twelve-chars-minimum
CORS_ORIGINS=https://your-domain.example
TRUSTED_HOSTS=your-domain.example,localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=20
SECURE_COOKIES=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_ALLOW_BROWSER_OAUTH=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
POSTGRES_USER=legal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=legal_scheduler
