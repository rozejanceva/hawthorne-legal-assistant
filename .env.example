# Local development (SQLite + demo calendar)
APP_ENV=development
SECRET_KEY=dev-only-change-me
CALENDAR_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./legal_scheduler.db
TIMEZONE=Europe/Skopje
WORKING_DAY_START=09:00
WORKING_DAY_END=17:00
LUNCH_START=12:00
LUNCH_END=13:00
SLOT_INTERVAL_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=30

# Google Calendar (authorize locally first, then copy token.json to the server)
# CALENDAR_MODE=google
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
# GOOGLE_ALLOW_BROWSER_OAUTH=true

# Transactional email (optional; bookings still succeed if unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=appointments@example.com
# SMTP_USE_TLS=true
